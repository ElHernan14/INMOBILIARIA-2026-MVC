@model INMOBILIARIA.Models.Reserva

@{
	ViewData["Title"] = "Detalle de la Reserva";
}

<div>
	<div>
		<h1>Reserva {{ reserva.Id }}</h1>
		<span v-if="reserva.Activo" class="badge rounded-pill text-bg-success px-3 py-2">Activo</span>
		<span v-else="badge rounded-pill text-bg-secondary px-3 py-2">Inactivo</span>

		<div>
			<p><b>Desde: </b>{{reserva.FechaDesde}}</p>
			<p><b>Hasta: </b>{{reserva.FechaHasta}}</p>
		</div>
	</div>
	<div>
		<div>
			<table>
				<thead>
					<tr>
						<th colspan="2">Inmueble</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Tipo</td>
						<td>{{reserva.Inmueble.TipoInmueble}}</td>
					</tr>
					<tr>
						<td>Direccion</td>
						<td>{{reserva.Inmueble.Direccion}}</td>
					</tr>
					<tr>
						<td>Coordenadas</td>
						<td>{{reserva.Inmueble.Coordenadas}}</td>
					</tr>
					<tr>
						<td>Propietario</td>
						<td>{{reserva.Propietario.Nombre}}</td>
					</tr>
					<tr>
						<td>Codigo de Propietario</td>
						<td>{{reserva.Propietario.Id}}</td>
					</tr>
				</tbody>
			</table>
		</div>
		<div>
			<table>
				<thead>
					<tr>
						<th colspan="2">Inquilino</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Nombre</td>
						<td>{{reserva.Inquilino.Nombre}}</td>
					</tr>
					<tr>
						<td>Codigo del Inquilino</td>
						<td>{{reserva.Inquilino.Id}}</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</div>