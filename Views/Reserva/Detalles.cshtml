@model INMOBILIARIA.Models.Reserva

@{
	ViewData["Title"] = "Detalle de la Reserva";
}

<div class="shadow justify-content-center d-grid w-auto m-auto p-4 card" style="max-width:fit-content">
	<div>
		<h1>Reserva @Model.Id</h1>

		@if (@Model.Activo) 
		{
			<span class="badge rounded-pill text-bg-success px-3 py-2">Activo</span>
		}
		else 
		{
			<span class="badge rounded-pill text-bg-secondary px-3 py-2">Inactivo</span>
		}

		<div>
			<p><b>Desde: </b>@Model.FechaDesde</p>
			<p><b>Hasta: </b>@Model.FechaHasta</p>
		</div>
	</div>
	<div class="row">
		<div class="col border-end">
			<table class="table table-striped-columns">
				<thead>
					<tr>
						<th colspan="2">Inmueble</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Tipo</td>
						<td>@Model.Inmueble.TipoInmueble</td>
					</tr>
					<tr>
						<td>Direccion</td>
						<td>@Model.Inmueble.Direccion</td>
					</tr>
					<tr>
						<td>Coordenadas</td>
						<td>@Model.Inmueble.Cordenadas</td>
					</tr>
					<tr>
						<td>Propietario</td>
						<td>@Model.Inmueble.Propietario.Nombre @Model.Inmueble.Propietario.Apellido</td>
					</tr>
					<tr>
						<td>Codigo de Propietario</td>
						<td>@Model.Inmueble.Propietario.Id</td>
					</tr>
				</tbody>
			</table>
		</div>
		<div class="col border-start">
			<table class="table table-striped-columns">
				<thead>
					<tr>
						<th colspan="2">Inquilino</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Nombre</td>
						<td>@Model.Inquilino.Nombre</td>
					</tr>
					<tr>
						<td>Apellido</td>
						<td>@Model.Inquilino.Apellido</td>
					</tr>
					<tr>
						<td>DNI</td>
						<td>@Model.Inquilino.Dni</td>
					</tr>
					<tr>
						<td>Email</td>
						<td>@Model.Inquilino.Email</td>
					</tr>
					<tr>
						<td>Codigo del Inquilino</td>
						<td>@Model.Inquilino.Id</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</div>