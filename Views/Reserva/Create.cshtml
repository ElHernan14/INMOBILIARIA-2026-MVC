@model INMOBILIARIA.Models.Reserva

@{
    ViewData["Title"] = "Nueva reserva";
}

<div class="container py-4" id="reserva-create-app" v-cloak>
    <div class="mx-auto" style="max-width: 1250px;">
        <!-- Encabezado -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h3 fw-bold mb-1">Nueva reserva</h1>
                <p class="text-body-secondary mb-0">Registrá una nueva reserva en el sistema.</p>
            </div>
        </div>

        <!-- Indicador de pasos Reactivo -->
        <div class="d-flex justify-content-between mb-4">
            <span :class="badgeClass(1)">1. Inmueble</span>
            <span :class="badgeClass(2)">2. Fechas</span>
            <span :class="badgeClass(3)">3. Inquilino</span>
        </div>

        <!-- Mensajes de Error de Vue / Servidor -->
        <div v-if="errorMsg" class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            {{ errorMsg }}
            <button type="button" class="btn-close" @@click="errorMsg = ''"></button>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm" role="alert"></div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Paso {{ currentStep }}: {{ tituloPaso }}</h5>

                <form asp-action="Create" method="post" id="wizardForm" @@submit="validarFormularioFinal">
                    @Html.AntiForgeryToken()
                    
                    <!-- Campos ocultos sincronizados con el estado de Vue -->
                    <input type="hidden" asp-for="InmuebleId" :value="form.inmuebleId" />
                    <input type="hidden" asp-for="InquilinoId" :value="form.inquilinoId" />
                    <input type="hidden" asp-for="FechaDesde" :value="form.fechaDesde" />
                    <input type="hidden" asp-for="FechaHasta" :value="form.fechaHasta" />

                    <!-- PASO 1: Selección de Inmueble -->
                    <div v-show="currentStep === 1">
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body p-3 p-md-4">
                                <div class="row g-3 align-items-end">
                                    <div class="col-12 col-lg-5">
                                        <label for="termino" class="form-label fw-semibold">Buscar Inmueble</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-body"><i class="bi bi-search"></i></span>
                                            <input type="text" v-model="filtrosInmueble.termino" @@keyup.enter="buscarInmuebles(1)" class="form-control" placeholder="Dirección, propietario o tipo..." />
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-2 d-flex gap-2">
                                        <button type="button" class="btn btn-primary flex-grow-1" @@click="buscarInmuebles(1)">
                                            <i class="bi bi-funnel me-1"></i> Filtrar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Listado de Inmuebles -->
                        <div class="card border-0 shadow-sm overflow-hidden mb-3">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Inmueble</th>
                                            <th>Propietario</th>
                                            <th>Precio / día</th>
                                            <th class="text-center">Cupo</th>
                                            <th>Estado</th>
                                            <th class="text-end pe-3 pe-md-4">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr v-if="loadingInmuebles">
                                            <td colspan="6" class="text-center py-4">
                                                <div class="spinner-border text-primary" role="status"></div>
                                            </td>
                                        </tr>
                                        <tr v-else-if="inmuebles.length === 0">
                                            <td colspan="6" class="text-center py-4">No se encontraron inmuebles.</td>
                                        </tr>
                                        <tr v-for="item in inmuebles" :key="item.id" :class="{'table-active': form.inmuebleId === item.id}">
                                            <td>{{ item.direccion || '-' }}</td>
                                            <td>{{ item.propietario ? `${item.propietario.nombre} ${item.propietario.apellido}` : '-' }}</td>
                                            <td>${{ item.precio }}</td>
                                            <td class="text-center">{{ item.cupo }}</td>
                                            <td><span class="badge bg-success">Disponible</span></td>
                                            <td class="text-end pe-3 pe-md-4">
                                                <button type="button" 
                                                        :class="['btn btn-sm', form.inmuebleId === item.id ? 'btn-success' : 'btn-outline-primary']" 
                                                        @@click="seleccionarInmueble(item)">
                                                    {{ form.inmuebleId === item.id ? 'Seleccionado' : 'Seleccionar' }}
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-primary" @@click="nextStep(2)">
                                Siguiente <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- PASO 2: Selección de Fechas -->
                    <div v-show="currentStep === 2">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Selecciona el rango de fechas</label>
                            <input type="text" ref="calendarioInput" class="form-control bg-white" placeholder="Haz clic para seleccionar inicio y fin..." readonly />
                            <small class="text-muted mt-1 d-block">
                                <i class="bi bi-info-circle"></i> Las fechas deshabilitadas corresponden a reservas existentes para este inmueble.
                            </small>
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" @@click="nextStep(1)">
                                <i class="bi bi-arrow-left"></i> Anterior
                            </button>
                            <button type="button" class="btn btn-primary" @@click="nextStep(3)">
                                Siguiente <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- PASO 3: Selección de Inquilino -->
                    <div v-show="currentStep === 3">
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body p-3 p-md-4">
                                <div class="row g-3">
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label fw-semibold">Nombre</label>
                                        <input type="text" v-model="filtrosInquilino.nombre" class="form-control" placeholder="Ej: Juan" />
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label fw-semibold">Apellido</label>
                                        <input type="text" v-model="filtrosInquilino.apellido" class="form-control" placeholder="Ej: Pérez" />
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label fw-semibold">DNI</label>
                                        <input type="text" v-model="filtrosInquilino.dni" class="form-control" placeholder="Ej: 35123456" />
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label fw-semibold">Email</label>
                                        <input type="text" v-model="filtrosInquilino.email" class="form-control" placeholder="Ej: juan@mail.com" />
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button type="button" class="btn btn-outline-secondary" @@click="limpiarFiltrosInquilino">
                                        <i class="bi bi-x-circle me-1"></i> Limpiar
                                    </button>
                                    <button type="button" class="btn btn-primary" @@click="buscarInquilinos(1)">
                                        <i class="bi bi-search me-1"></i> Buscar
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Listado Inquilinos -->
                        <div class="card border-0 shadow-sm overflow-hidden mb-3">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Nombre Completo</th>
                                            <th>DNI</th>
                                            <th>Teléfono</th>
                                            <th>Email</th>
                                            <th class="text-end pe-3 pe-md-4">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr v-if="loadingInquilinos">
                                            <td colspan="5" class="text-center py-4">
                                                <div class="spinner-border text-primary" role="status"></div>
                                            </td>
                                        </tr>
                                        <tr v-else-if="inquilinos.length === 0">
                                            <td colspan="5" class="text-center py-4">Utilizá los filtros para buscar inquilinos.</td>
                                        </tr>
                                        <tr v-for="inquilino in inquilinos" :key="inquilino.id" :class="{'table-active': form.inquilinoId === inquilino.id}">
                                            <td>{{ inquilino.nombre }} {{ inquilino.apellido }}</td>
                                            <td>{{ inquilino.dni }}</td>
                                            <td>{{ inquilino.telefono || '-' }}</td>
                                            <td>{{ inquilino.email || '-' }}</td>
                                            <td class="text-end pe-3 pe-md-4">
                                                <button type="button" 
                                                        :class="['btn btn-sm', form.inquilinoId === inquilino.id ? 'btn-success' : 'btn-outline-primary']" 
                                                        @@click="seleccionarInquilino(inquilino)">
                                                    {{ form.inquilinoId === inquilino.id ? 'Seleccionado' : 'Seleccionar' }}
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="button" class="btn btn-outline-secondary" @@click="nextStep(2)">
                                <i class="bi bi-arrow-left"></i> Anterior
                            </button>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-calendar-check me-1"></i> Crear reserva
                            </button>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    currentStep: 1,
                    errorMsg: '',
                    
                    form: {
                        inmuebleId: null,
                        inquilinoId: null,
                        fechaDesde: null,
                        fechaHasta: null
                    },

                    // Inmuebles
                    loadingInmuebles: false,
                    inmuebles: [],
                    filtrosInmueble: {
                        termino: ''
                    },

                    // Fechas bloqueadas
                    reservasFuturas: [],

                    // Inquilinos
                    loadingInquilinos: false,
                    inquilinos: [],
                    filtrosInquilino: {
                        nombre: '',
                        apellido: '',
                        dni: '',
                        email: ''
                    },

                    flatpickrInstance: null
                };
            },

            computed: {
                tituloPaso() {
                    switch (this.currentStep) {
                        case 1: return 'Seleccioná el inmueble';
                        case 2: return 'Elegí las fechas de la reserva';
                        case 3: return 'Seleccioná el inquilino';
                        default: return '';
                    }
                }
            },

            mounted() {
                this.initFlatpickr();
            },

            methods: {
                badgeClass(step) {
                    const baseClass = "badge fs-6 p-2 w-100 me-2 text-center ";
                    if (this.currentStep === step) return baseClass + "bg-primary";
                    if (this.currentStep > step) return baseClass + "bg-success";
                    return baseClass + "bg-secondary";
                },

                nextStep(step) {
                    this.errorMsg = '';

                    if (step === 2 && !this.form.inmuebleId) {
                        this.errorMsg = 'Por favor, selecciona un inmueble antes de continuar.';
                        return;
                    }

                    if (step === 3) {
                        if (!this.form.fechaDesde || !this.form.fechaHasta) {
                            this.errorMsg = 'Por favor, selecciona las fechas de inicio y fin.';
                            return;
                        }
                        if (new Date(this.form.fechaDesde) >= new Date(this.form.fechaHasta)) {
                            this.errorMsg = 'La fecha de fin debe ser posterior a la fecha de inicio.';
                            return;
                        }
                    }

                    this.currentStep = step;
                },

                async buscarInmuebles(pagina = 1) {
                    this.loadingInmuebles = true;
                    try {
                        const response = await fetch(`/Inmueble/BuscarInmueble?termino=${encodeURIComponent(this.filtrosInmueble.termino)}&page=${pagina}`);
                        if (!response.ok) throw new Error('Error en la búsqueda de inmuebles');
                        
                        const data = await response.json();
                        this.inmuebles = data.resultados || [];
                    } catch (error) {
                        console.error(error);
                        this.errorMsg = 'No se pudieron cargar los inmuebles.';
                    } finally {
                        this.loadingInmuebles = false;
                    }
                },

                async seleccionarInmueble(inmueble) {
                    this.form.inmuebleId = inmueble.id;
                    // Limpiar las fechas previa selección si cambia de inmueble
                    this.form.fechaDesde = null;
                    this.form.fechaHasta = null;
                    if (this.flatpickrInstance) {
                        this.flatpickrInstance.clear();
                    }

                    // Cargar reservas futuras para deshabilitar fechas ocupadas
                    await this.cargarReservasFuturas(inmueble.id);
                },

                async cargarReservasFuturas(inmuebleId) {
                    try {
                        const response = await fetch(`/Reserva/ObtenerPorInmuebleFuturas?id=${inmuebleId}`);
                        if (!response.ok) throw new Error('Error al consultar reservas existentes');

                        const data = await response.json();
                        // Mapear los datos al formato que acepta Flatpickr: { from: 'YYYY-MM-DD', to: 'YYYY-MM-DD' }
                        this.reservasFuturas = (data || []).map(r => ({
                            from: r.fechaDesde.split('T')[0],
                            to: r.fechaHasta.split('T')[0]
                        }));

                        // Actualizar la opción disable de Flatpickr con los nuevos rangos
                        if (this.flatpickrInstance) {
                            this.flatpickrInstance.set('disable', this.reservasFuturas);
                        }
                    } catch (error) {
                        console.error('Error obteniendo reservas futuras:', error);
                        this.errorMsg = 'No se pudieron obtener las fechas ocupadas de este inmueble.';
                    }
                },

                async buscarInquilinos(pagina = 1) {
                    this.loadingInquilinos = true;
                    const params = new URLSearchParams({
                        nombre: this.filtrosInquilino.nombre,
                        apellido: this.filtrosInquilino.apellido,
                        dni: this.filtrosInquilino.dni,
                        email: this.filtrosInquilino.email,
                        page: pagina
                    });

                    try {
                        const response = await fetch(`/Inquilino/BuscarInquilino?${params.toString()}`);
                        if (!response.ok) throw new Error('Error en la búsqueda de inquilinos');
                        
                        const data = await response.json();
                        this.inquilinos = data.resultados || [];
                    } catch (error) {
                        console.error(error);
                        this.errorMsg = 'No se pudieron cargar los inquilinos.';
                    } finally {
                        this.loadingInquilinos = false;
                    }
                },

                limpiarFiltrosInquilino() {
                    this.filtrosInquilino = { nombre: '', apellido: '', dni: '', email: '' };
                    this.inquilinos = [];
                },

                seleccionarInquilino(inquilino) {
                    this.form.inquilinoId = inquilino.id;
                },

                initFlatpickr() {
                    if (this.$refs.calendarioInput) {
                        this.flatpickrInstance = flatpickr(this.$refs.calendarioInput, {
                            locale: "es",
                            mode: "range",
                            dateFormat: "Y-m-d",
                            minDate: "today",
                            disable: this.reservasFuturas, // Rangos deshabilitados dinámicamente
                            onChange: (selectedDates, dateStr, instance) => {
                                if (selectedDates.length === 2) {
                                    this.form.fechaDesde = instance.formatDate(selectedDates[0], "Y-m-d");
                                    this.form.fechaHasta = instance.formatDate(selectedDates[1], "Y-m-d");
                                } else {
                                    this.form.fechaDesde = null;
                                    this.form.fechaHasta = null;
                                }
                            }
                        });
                    }
                },

                validarFormularioFinal(event) {
                    if (!this.form.inmuebleId || !this.form.inquilinoId || !this.form.fechaDesde || !this.form.fechaHasta) {
                        event.preventDefault();
                        this.errorMsg = 'Faltan datos obligatorios para registrar la reserva.';
                    }
                }
            }
        }).mount("#reserva-create-app");
    </script>
}