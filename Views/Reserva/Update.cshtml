```razor
@model INMOBILIARIA.Models.Reserva

@{
    ViewData["Title"] = "Editar reserva";

    IEnumerable<INMOBILIARIA.Models.Inmueble> inmuebles =
        ViewBag.Inmuebles as IEnumerable<INMOBILIARIA.Models.Inmueble>
        ?? Enumerable.Empty<INMOBILIARIA.Models.Inmueble>();

    IEnumerable<INMOBILIARIA.Models.Inquilino> inquilinos =
        ViewBag.Inquilinos as IEnumerable<INMOBILIARIA.Models.Inquilino>
        ?? Enumerable.Empty<INMOBILIARIA.Models.Inquilino>();

    int inmuebleSeleccionado = Model.Inmueble?.Id ?? 0;
    int inquilinoSeleccionado = Model.Inquilino?.Id ?? 0;
}

<div class="container py-4">

    <div class="mx-auto" style="max-width: 850px;">

        <div class="mb-4">

            <div class="d-flex align-items-center gap-2 mb-2">

                <a asp-action="Index"
                   class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                </a>

                <span class="text-muted small">
                    Reservas
                </span>

            </div>

            <h1 class="h3 fw-bold mb-1">
                Editar reserva
            </h1>

            <p class="text-muted mb-0">
                Modificá los datos de la reserva seleccionada.
            </p>

        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-md-5">

                <form asp-action="Update" method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="row g-4">

                        <!-- Inmueble -->
                        <div class="col-12">

                            <label for="Inmueble_Id"
                                   class="form-label fw-semibold">
                                Inmueble
                            </label>

                            <select id="Inmueble_Id"
                                    name="Inmueble.Id"
                                    class="form-select">

                                <option value="">
                                    Seleccioná un inmueble
                                </option>

                                @foreach (var inmueble in inmuebles)
                                {
                                    if (inmueble.Id == inmuebleSeleccionado)
                                    {
                                        <option value="@inmueble.Id"
                                                selected="selected">
                                            @inmueble.Direccion
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@inmueble.Id">
                                            @inmueble.Direccion
                                        </option>
                                    }
                                }

                            </select>

                            @if (ViewData.ModelState.ContainsKey("Inmueble"))
                            {
                                <span class="text-danger small">
                                    @Html.ValidationMessage("Inmueble")
                                </span>
                            }

                        </div>

                        <!-- Inquilino -->
                        <div class="col-12">

                            <label for="Inquilino_Id"
                                   class="form-label fw-semibold">
                                Inquilino
                            </label>

                            <select id="Inquilino_Id"
                                    name="Inquilino.Id"
                                    class="form-select">

                                <option value="">
                                    Seleccioná un inquilino
                                </option>

                                @foreach (var inquilino in inquilinos)
                                {
                                    if (inquilino.Id == inquilinoSeleccionado)
                                    {
                                        <option value="@inquilino.Id"
                                                selected="selected">
                                            @inquilino.Apellido,
                                            @inquilino.Nombre
                                            — DNI @inquilino.Dni
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@inquilino.Id">
                                            @inquilino.Apellido,
                                            @inquilino.Nombre
                                            — DNI @inquilino.Dni
                                        </option>
                                    }
                                }

                            </select>

                            @if (ViewData.ModelState.ContainsKey("Inquilino"))
                            {
                                <span class="text-danger small">
                                    @Html.ValidationMessage("Inquilino")
                                </span>
                            }

                        </div>

                        <!-- Fecha desde -->
                        <div class="col-12 col-md-6">

                            <label asp-for="FechaDesde"
                                   class="form-label fw-semibold">
                                Fecha desde
                            </label>

                            <input asp-for="FechaDesde"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="FechaDesde"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Fecha hasta -->
                        <div class="col-12 col-md-6">

                            <label asp-for="FechaHasta"
                                   class="form-label fw-semibold">
                                Fecha hasta
                            </label>

                            <input asp-for="FechaHasta"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="FechaHasta"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                    <hr class="my-4">

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-between gap-2">

                        <a asp-action="Detalles"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle me-1"></i>
                            Guardar cambios
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
```
