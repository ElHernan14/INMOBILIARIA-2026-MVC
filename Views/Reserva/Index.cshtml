@model INMOBILIARIA.Models.PagedResults<INMOBILIARIA.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div id="reserva-app" class="container py-4">
    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                Reservas
            </h1>
            <p class="text-muted mb-0">
                Listado de reservas registradas en la inmobiliaria.
            </p>
        </div>

        <div>
            <a asp-controller="Reserva"
               asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-calendar-plus me-1"></i>
                Añadir reserva
            </a>
        </div>
    </div>

    <!-- Alertas -->
    <div id="successAlert"
         class="alert alert-success"
         role="alert"
         hidden>
    </div>

    <div id="errorAlert"
         class="alert alert-danger"
         role="alert"
         hidden>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <!-- Listado -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <!-- Cabecera -->
        <div class="card-header bg-white border-bottom py-3 px-3 px-md-4">
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 rounded-3 p-2 me-3">
                    <i class="bi bi-calendar-check text-primary fs-5"></i>
                </div>

                <div>
                    <h2 class="h6 fw-bold mb-0">
                        Reservas registradas
                    </h2>
                    <small class="text-muted">
                        Información general
                    </small>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3 ps-md-4">
                            Reserva
                        </th>
                        <th>
                            Inmueble
                        </th>
                        <th>
                            Período
                        </th>
                        <th>
                            Estado
                        </th>
                        <th class="text-end pe-3 pe-md-4">
                            Acciones
                        </th>
                    </tr>
                </thead>

                <tbody>
                    <!-- Estado vacío -->
                    <tr v-if="reserva.length === 0">
                        <td colspan="5" class="text-center py-5">
                            <div class="mb-2">
                                <i class="bi bi-calendar-x fs-2 text-muted"></i>
                            </div>

                            <div class="fw-semibold">
                                No hay reservas registradas
                            </div>

                            <small class="text-muted">
                                Cuando se registren reservas aparecerán aquí.
                            </small>
                        </td>
                    </tr>

                    <!-- Reservas -->
                    <tr v-for="Reserva in reserva"
                        :key="Reserva.Id">

                        <!-- Reserva / Inquilino -->
                        <td class="ps-3 ps-md-4">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary bg-opacity-10
                                            text-primary d-flex align-items-center
                                            justify-content-center me-3 flex-shrink-0"
                                     style="width: 42px; height: 42px;">
                                    <span class="fw-bold">
                                        {{ iniciales(Reserva) }}
                                    </span>
                                </div>

                                <div class="min-w-0">
                                    <div class="fw-semibold text-break">
                                        {{ Reserva.Inquilino?.Nombre }}
                                        {{ Reserva.Inquilino?.Apellido }}
                                    </div>

                                    <small class="text-muted">
                                        Reserva #COD-00{{ Reserva.Id }}
                                    </small>
                                </div>
                            </div>
                        </td>

                        <!-- Inmueble -->
                        <td>
                            <div class="fw-semibold text-break">
                                {{ Reserva.Inmueble?.Direccion ?? '—' }}
                            </div>

                            <small class="text-muted">
                                Inmueble #COD-00{{ Reserva.Inmueble?.Id ?? '—' }}
                            </small>
                        </td>

                        <!-- Período -->
                        <td>
                            <div class="text-nowrap">
                                {{ formatearFecha(Reserva.FechaDesde) }}
                                <span class="text-muted mx-1">→</span>
                                {{ formatearFecha(Reserva.FechaHasta) }}
                            </div>
                        </td>

                        <!-- Estado -->
                        <td>
                            <span v-if="Reserva.Activo"
                                  class="badge rounded-pill text-bg-success">
                                Activo
                            </span>

                            <span v-else
                                  class="badge rounded-pill text-bg-secondary">
                                Inactivo
                            </span>
                        </td>

                        <!-- Acciones -->
                        <td class="text-end pe-3 pe-md-4">
                            <div class="d-flex flex-wrap justify-content-end gap-2">

                                <a :href="renovarUrl(Reserva.Id)"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square"></i>
                                    <span class="d-none d-lg-inline ms-1">
                                        Renovar
                                    </span>
                                </a>

                                <a :href="detailsUrl(Reserva.Id)"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                    <span class="d-none d-lg-inline ms-1">
                                        Ver detalles
                                    </span>
                                </a>

                                @if (User.IsInRole("ADMINISTRADOR"))
                                {
                                    <a href="#"
                                       @@click="eliminar(Reserva.Id)"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash-fill"></i>
                                        <span class="d-none d-lg-inline ms-1">
                                            Eliminar
                                        </span>
                                    </a>
                                }

                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Paginado -->
    <div class="mt-3">
        <nav aria-label="Paginación de reservas">
            <ul class="pagination justify-content-center flex-wrap mb-0">

                <li class="page-item"
                    :class="{ disabled: currentPage === 1 }">
                    <a class="page-link"
                       :href="getPage(currentPage - 1)">
                        <span class="d-none d-sm-inline">Anterior</span>
                        <span class="d-inline d-sm-none">‹</span>
                    </a>
                </li>

                <li class="page-item"
                    v-for="(page, index) in visiblePages"
                    :key="index"
                    :class="{
                        active: currentPage === page,
                        disabled: page === '...'
                    }">

                    <a class="page-link"
                       v-if="page !== '...'"
                       :href="getPage(page)">
                        {{ page }}
                    </a>

                    <span class="page-link"
                          v-else>
                        ...
                    </span>
                </li>

                <li class="page-item"
                    :class="{ disabled: currentPage === totalPages }">
                    <a class="page-link"
                       :href="getPage(currentPage + 1)">
                        <span class="d-none d-sm-inline">Siguiente</span>
                        <span class="d-inline d-sm-none">›</span>
                    </a>
                </li>

            </ul>
        </nav>
    </div>
</div>

@section Scripts {

    <!-- Vue 3 -->
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    /*
                     * Los datos son enviados por Razor desde el Controller.
                     * Vue no consulta ni genera datos.
                     */
                    reserva: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                            Model?.Resultados ?? new List<INMOBILIARIA.Models.Reserva>()
                        )
                    ),

                    currentPage: @Model?.CurrentPage ?? 1,
                    pageSize: @Model?.PageSize ?? 10,
                    totalResults: @Model?.TotalResults ?? 0,
                    totalPages: @Model?.TotalPages ?? 0
                };
            },

            computed: {
                visiblePages() {
                    const total = this.totalPages;
                    const current = this.currentPage;
                    const delta = 2;

                    if (total <= 7) {
                        return Array.from(
                            { length: total },
                            (_, i) => i + 1
                        );
                    }

                    const pages = [];

                    const left = Math.max(
                        2,
                        current - delta
                    );

                    const right = Math.min(
                        total - 1,
                        current + delta
                    );

                    pages.push(1);

                    if (left > 2) {
                        pages.push('...');
                    }

                    for (let i = left; i <= right; i++) {
                        pages.push(i);
                    }

                    if (right < total - 1) {
                        pages.push('...');
                    }

                    pages.push(total);

                    return pages;
                }
            },

            methods: {
                iniciales(Reserva) {
                    const nombre =
                        Reserva.Inquilino?.Nombre?.charAt(0) ?? "";

                    const apellido =
                        Reserva.Inquilino?.Apellido?.charAt(0) ?? "";

                    return (
                        nombre + apellido
                    ).toUpperCase();
                },

                formatearFecha(valor) {
                    if (!valor) return '—';

                    const partes = String(valor).split('-');

                    if (partes.length !== 3) {
                        return valor;
                    }

                    const [anio, mes, dia] = partes;

                    return `${dia}/${mes}/${anio}`;
                },

                detailsUrl(id) {
                    return `/Reserva/Detalles/${id}`;
                },

                renovarUrl(id) {
                    return `/Reserva/Renovar/${id}`;
                },

                async eliminar(id) {
                    let success =
                        document.getElementById("successAlert");

                    let error =
                        document.getElementById("errorAlert");

                    console.log("TB");

                    const response =
                        await fetch(`/Reserva/Delete/${id}`, {
                            method: "DELETE",
                            headers: {
                                "Content-Type": "application/json"
                            }
                        });

                    if (response.ok) {
                        error.hidden = true;

                        this.reserva =
                            this.reserva.filter(
                                p => p.Id !== id
                            );

                        success.textContent =
                            `Reserva código COD-00${id} eliminada.`;

                        success.hidden = false;
                    } else {
                        success.hidden = true;

                        error.textContent =
                            `No se pudo eliminar la reserva con el código COD-00${id}.`;

                        error.hidden = false;
                    }
                },

                getPage(index) {
                    return `/Reserva?page=${index}`;
                }
            }
        }).mount("#reserva-app");
    </script>
}