@model PagedResults<INMOBILIARIA.Models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
}

<div id="propietarios-app"
     class="container py-4">

    <div class="mx-auto" style="max-width: 1250px;">

        <!-- Encabezado -->
        <div class="d-flex flex-column flex-sm-row
                    justify-content-between
                    align-items-sm-center
                    gap-3 mb-4">

            <div>
                <h1 class="h3 fw-bold mb-1">
                    Propietarios
                </h1>

                <p class="text-muted mb-0">
                    Listado de propietarios registrados en la inmobiliaria.
                </p>
            </div>

            <div class="d-flex align-items-center">

                <a asp-controller="Propietario"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="fa-solid fa-plus me-2"></i>
                    Añadir propietario

                </a>

            </div>

        </div>

        <!-- Alertas -->
        <div id="successAlert"
             class="alert alert-success shadow-sm"
             role="alert"
             hidden>
        </div>

        <div id="errorAlert"
             class="alert alert-danger shadow-sm"
             role="alert"
             hidden>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success shadow-sm"
                 role="alert">
                @successMessage
            </div>
        }

        <!-- Listado -->
        <div class="card border-0 shadow-sm overflow-hidden">

            <!-- Cabecera -->
            <div class="card-header bg-white border-bottom py-3">

                <div class="d-flex align-items-center">

                    <div class="bg-primary bg-opacity-10
                                rounded-3 p-2 me-3 flex-shrink-0">

                        <span class="text-primary fw-bold">
                            P
                        </span>

                    </div>

                    <div>
                        <h2 class="h6 fw-bold mb-0">
                            Propietarios registrados
                        </h2>

                        <small class="text-muted">
                            Información general
                        </small>
                    </div>

                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-3 ps-md-4 py-3">
                                Propietario
                            </th>

                            <th class="py-3">
                                DNI
                            </th>

                            <th class="py-3">
                                Email
                            </th>

                            <th class="py-3">
                                Estado
                            </th>

                            <th class="text-end pe-3 pe-md-4 py-3">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        <!-- Estado vacío -->
                        <tr v-if="propietarios.length === 0">

                            <td colspan="5"
                                class="text-center py-5">

                                <div class="mb-2">
                                    <span class="fs-3 text-muted">
                                        —
                                    </span>
                                </div>

                                <div class="fw-semibold">
                                    No hay propietarios registrados
                                </div>

                                <small class="text-muted">
                                    Cuando se registren propietarios aparecerán aquí.
                                </small>

                            </td>

                        </tr>

                        <!-- Propietarios -->
                        <tr v-for="propietario in propietarios"
                            :key="propietario.Id">

                            <td class="ps-3 ps-md-4">

                                <div class="d-flex align-items-center">

                                    <!-- Avatar -->
                                    <div class="rounded-circle
                                                bg-primary bg-opacity-10
                                                text-primary
                                                d-flex align-items-center
                                                justify-content-center
                                                me-3
                                                flex-shrink-0"
                                         style="width: 42px; height: 42px;">

                                        <span class="fw-bold">
                                            {{ iniciales(propietario) }}
                                        </span>

                                    </div>

                                    <!-- Nombre -->
                                    <div class="text-nowrap">

                                        <div class="fw-semibold">
                                            {{ propietario.Nombre }}
                                            {{ propietario.Apellido }}
                                        </div>

                                        <small class="text-muted">
                                            Propietario #COD-00{{ propietario.Id }}
                                        </small>

                                    </div>

                                </div>

                            </td>

                            <td>
                                {{ propietario.Dni }}
                            </td>

                            <td>
                                <span class="text-break">
                                    {{ propietario.Email }}
                                </span>
                            </td>

                            <td>

                                <span v-if="propietario.Activo"
                                      class="badge rounded-pill text-bg-success">
                                    Activo
                                </span>

                                <span v-else
                                      class="badge rounded-pill text-bg-secondary">
                                    Inactivo
                                </span>

                            </td>

                            <!-- Acciones -->
                            <td class="text-end pe-3 pe-md-4">

                                <div class="d-flex
                                            flex-column flex-md-row
                                            justify-content-end
                                            gap-2">

                                    <a :href="editUrl(propietario.Id)"
                                       class="btn btn-sm btn-outline-primary px-3">

                                        <i class="bi bi-pencil-square"></i>

                                        <span class="d-none d-lg-inline ms-1">
                                            Editar
                                        </span>

                                    </a>

                                    <a :href="detailsUrl(propietario.Id)"
                                       class="btn btn-sm btn-outline-primary px-3">

                                        <i class="bi bi-eye"></i>

                                        <span class="d-none d-lg-inline ms-1">
                                            Ver detalles
                                        </span>

                                    </a>

                                    @if (User.IsInRole("ADMINISTRADOR"))
                                    {
                                        <a href="#"
                                           @@click="deleteUrl(propietario.Id)"
                                           class="btn btn-sm btn-outline-danger px-3">

                                            <i class="bi bi-trash-fill"></i>

                                            <span class="d-none d-lg-inline ms-1">
                                                Eliminar
                                            </span>

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

        <!-- Paginado -->
        <div>

            <nav aria-label="Page navigation"
                 class="py-4">

                <ul class="pagination justify-content-center flex-wrap mb-0">

                    <li class="page-item"
                        :class="{ disabled: currentPage === 1 }">

                        <a class="page-link"
                           :href="getPage(currentPage - 1)">

                            <i class="fa-solid fa-angles-left"></i>

                            <span class="d-none d-sm-inline ms-1">
                                Anterior
                            </span>

                        </a>

                    </li>

                    <li class="page-item"
                        v-for="(page, index) in visiblePages"
                        :key="index"
                        :class="{
                            active: currentPage === page,
                            disabled: page === '...'
                        }">

                        <a class="page-link"
                           v-if="page !== '...'"
                           :href="getPage(page)">
                            {{ page }}
                        </a>

                        <span class="page-link"
                              v-else>
                            ...
                        </span>

                    </li>

                    <li class="page-item"
                        :class="{ disabled: currentPage === totalPages }">

                        <a class="page-link"
                           :href="getPage(currentPage + 1)">

                            <span class="d-none d-sm-inline me-1">
                                Siguiente
                            </span>

                            <i class="fa-solid fa-angles-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>

    </div>

</div>

@section Scripts {

    <!-- Vue 3 -->
    <script>

        const { createApp } = Vue;

        createApp({

            data() {

                return {

                    /*
                     * Los datos son enviados por Razor desde el Controller.
                     * Vue no consulta ni genera datos.
                     */
                    propietarios:
                        @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                Model?.Resultados ??
                                new List<INMOBILIARIA.Models.Propietario>()
                            )
                        ),

                    currentPage:
                        @Model?.CurrentPage ?? 1,

                    pageSize:
                        @Model?.PageSize ?? 10,

                    totalResults:
                        @Model?.TotalResults ?? 0,

                    totalPages:
                        @Model?.TotalPages ?? 0
                };

            },

            computed: {

                visiblePages() {

                    const total = this.totalPages;
                    const current = this.currentPage;

                    // Number of buttons to show on each side of the current page
                    const delta = 2;

                    // If the total pages are 7 or less show all of them
                    if (total <= 7) {

                        return Array.from(
                            { length: total },
                            (_, i) => i + 1
                        );

                    }

                    const pages = [];

                    // Calculate the window of pages around the current page
                    const left =
                        Math.max(2, current - delta);

                    const right =
                        Math.min(total - 1, current + delta);

                    // Always show the first page
                    pages.push(1);

                    // Add an ellipsis if there is a gap between 1 and the left window
                    if (left > 2) {
                        pages.push('...');
                    }

                    // Add the numbers in the window
                    for (let i = left; i <= right; i++) {
                        pages.push(i);
                    }

                    // Add an ellipsis if there is a gap between the right window and the last page
                    if (right < total - 1) {
                        pages.push('...');
                    }

                    // Always show the last page
                    pages.push(total);

                    return pages;
                }

            },

            methods: {

                iniciales(propietario) {

                    const nombre =
                        propietario.Nombre?.charAt(0) ?? "";

                    const apellido =
                        propietario.Apellido?.charAt(0) ?? "";

                    return (
                        nombre + apellido
                    ).toUpperCase();

                },

                detailsUrl(id) {

                    return `/Propietario/Detalles/${id}`;

                },

                editUrl(id) {

                    return `/Propietario/Update/${id}`;

                },

                async deleteUrl(id) {

                    let success =
                        document.getElementById("successAlert");

                    let error =
                        document.getElementById("errorAlert");

                    const response =
                        await fetch(
                            `/Propietario/Delete/${id}`,
                            {
                                method: "DELETE",
                                headers: {
                                    "Content-Type": "application/json"
                                }
                            }
                        );

                    if (response.ok) {

                        error.hidden = true;

                        this.propietarios =
                            this.propietarios.filter(
                                p => p.Id !== id
                            );

                        success.textContent =
                            `Propietario codigo COD-00${id} eliminado.`;

                        success.hidden = false;

                    } else {

                        success.hidden = true;

                        error.textContent =
                            `No se pudo eliminar el propietario con el codigo COD-00${id}.`;

                        error.hidden = false;

                    }

                },

                getPage(index) {

                    return `/Propietario?page=${index}`;

                }

            }

        }).mount("#propietarios-app");

    </script>

}