@model INMOBILIARIA.Models.Inmueble

@{
    ViewData["Title"] = "Detalle del inmueble";

    IEnumerable<INMOBILIARIA.Models.ImagenInmueble> imagenes =
        ViewBag.Imagenes
        ?? Enumerable.Empty<INMOBILIARIA.Models.ImagenInmueble>();

    INMOBILIARIA.Models.ImagenInmueble? imagenPortada =
        imagenes.FirstOrDefault(imagen => imagen.EsPortada);

    INMOBILIARIA.Models.ImagenInmueble? imagenPrincipal =
        imagenPortada ?? imagenes.FirstOrDefault();

    IEnumerable<INMOBILIARIA.Models.ImagenInmueble> imagenesGaleria =
        imagenes.Where(imagen =>
            imagenPrincipal == null ||
            imagen.Id != imagenPrincipal.Id);
}

<div class="container py-4">
    <div class="mx-auto" style="max-width: 1250px;">

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm"
                 role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["Mensaje"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm"
                 role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <!-- Encabezado -->
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center
                    gap-3 mb-4">

            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <a asp-action="Index"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i>
                    </a>

                    <span class="text-body-secondary small">
                        Inmuebles
                    </span>

                    <i class="bi bi-chevron-right
                              text-body-secondary small">
                    </i>

                    <span class="small">
                        Detalle
                    </span>
                </div>

                <h1 class="h3 fw-bold mb-1">
                    @Model.TipoInmueble?.Nombre
                </h1>

                <p class="text-body-secondary mb-0">
                    <i class="bi bi-geo-alt me-1"></i>
                    @Model.Direccion
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Editar"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary d-inline-flex
                          align-items-center gap-2">
                    <i class="bi bi-pencil"></i>
                    Editar
                </a>

                @if (Model.Activo)
                {
                    <form asp-action="Eliminar"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('¿Seguro que querés dar de baja este inmueble?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger
                                       d-inline-flex align-items-center
                                       gap-2">
                            <i class="bi bi-trash"></i>
                            Dar de baja
                        </button>
                    </form>
                }
            </div>
        </div>

        <!-- Galería / portada -->
        <div class="card border-0 shadow-sm overflow-hidden mb-4">

            <div class="row g-0">

                <!-- Imagen principal -->
                <div class="col-12 col-lg-8">
                    @if (imagenPrincipal != null)
                    {
                        <div class="bg-body-secondary"
                             style="min-height: 390px;">

                            <img src="@imagenPrincipal.Path"
                                 alt="Imagen del inmueble"
                                 class="w-100 h-100"
                                 style="min-height: 390px;
                                        max-height: 520px;
                                        object-fit: cover;" />
                        </div>
                    }
                    else
                    {
                        <div class="bg-body-secondary
                                    d-flex align-items-center
                                    justify-content-center"
                             style="min-height: 390px;">

                            <div class="text-center text-body-secondary px-3">
                                <i class="bi bi-image display-1 mb-3"></i>

                                <div class="fw-semibold">
                                    Sin imágenes
                                </div>

                                <div class="small">
                                    Este inmueble todavía no tiene
                                    imágenes cargadas.
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Galería -->
                <div class="col-12 col-lg-4 border-start-lg">

                    <div class="p-3 p-md-4">

                        <div class="d-flex justify-content-between
                                    align-items-center mb-3">

                            <h2 class="h6 fw-bold mb-0">
                                Galería
                            </h2>

                            <span class="badge text-bg-light border">
                                @imagenes.Count()
                                @(imagenes.Count() == 1 ? "imagen" : "imágenes")
                            </span>
                        </div>

                        @if (imagenesGaleria.Any())
                        {
                            <div class="row g-2">
                                @foreach (var imagen in imagenesGaleria)
                                {
                                    <div class="col-4">
                                        <div class="ratio ratio-1x1
                                                    rounded-3
                                                    overflow-hidden
                                                    bg-body-secondary">

                                            <img src="@imagen.Path"
                                                 alt="Imagen del inmueble"
                                                 class="w-100 h-100"
                                                 style="object-fit: cover;" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="rounded-3
                                        bg-body-secondary
                                        d-flex align-items-center
                                        justify-content-center
                                        text-center p-4">

                                <div class="text-body-secondary">
                                    <i class="bi bi-images fs-3 mb-2"></i>

                                    <div class="small">
                                        @if (imagenPrincipal != null)
                                        {
                                            <span>
                                                Solo hay una imagen cargada.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                No hay imágenes cargadas.
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @if (imagenPortada != null)
                        {
                            <div class="mt-3">
                                <div class="small text-body-secondary">
                                    <i class="bi bi-star-fill me-1"></i>
                                    Imagen de portada
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Información principal -->
        <div class="row g-4">

            <!-- Datos del inmueble -->
            <div class="col-12 col-lg-8">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-header bg-body border-0
                                px-3 px-md-4 pt-4 pb-2">

                        <h2 class="h5 fw-bold mb-0">
                            Información del inmueble
                        </h2>
                    </div>

                    <div class="card-body px-3 px-md-4">

                        <!-- Destacados -->
                        <div class="row g-3 mb-4">

                            <div class="col-12 col-sm-4">
                                <div class="rounded-3
                                            bg-primary bg-opacity-10
                                            p-3 h-100">

                                    <div class="small text-body-secondary mb-1">
                                        Precio por día
                                    </div>

                                    <div class="fs-5 fw-bold">
                                        @Model.PrecioDia.ToString("C2")
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-4">
                                <div class="rounded-3
                                            bg-body-secondary
                                            p-3 h-100">

                                    <div class="small text-body-secondary mb-1">
                                        Cupo
                                    </div>

                                    <div class="fs-5 fw-bold">
                                        @Model.Cupo
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-4">
                                <div class="rounded-3
                                            bg-body-secondary
                                            p-3 h-100">

                                    <div class="small text-body-secondary mb-1">
                                        Reserva
                                    </div>

                                    <div class="fs-5 fw-bold">
                                        @Model.PorcentajeReserva.ToString("0.##")%
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4">

                            <!-- Tipo -->
                            <div class="col-12 col-md-6">

                                <div class="small text-body-secondary mb-1">
                                    Tipo de inmueble
                                </div>

                                <div class="fw-semibold">
                                    <i class="bi bi-building me-2"></i>

                                    @(Model.TipoInmueble?.Nombre
                                        ?? "Sin tipo")
                                </div>
                            </div>

                            <!-- Dirección -->
                            <div class="col-12 col-md-6">

                                <div class="small text-body-secondary mb-1">
                                    Dirección
                                </div>

                                <div class="fw-semibold">
                                    <i class="bi bi-geo-alt me-2"></i>
                                    @Model.Direccion
                                </div>
                            </div>

                            <!-- Latitud -->
                            <div class="col-12 col-md-6">

                                <div class="small text-body-secondary mb-1">
                                    Latitud
                                </div>

                                <div class="fw-semibold">
                                    @if (Model.Latitud.HasValue)
                                    {
                                        @Model.Latitud.Value.ToString("0.#######")
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            No registrada
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Longitud -->
                            <div class="col-12 col-md-6">

                                <div class="small text-body-secondary mb-1">
                                    Longitud
                                </div>

                                <div class="fw-semibold">
                                    @if (Model.Longitud.HasValue)
                                    {
                                        @Model.Longitud.Value.ToString("0.#######")
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            No registrada
                                        </span>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Estados -->
            <div class="col-12 col-lg-4">

                <!-- Estado -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-body border-0
                                px-3 px-md-4 pt-4 pb-2">

                        <h2 class="h5 fw-bold mb-0">
                            Estado
                        </h2>
                    </div>

                    <div class="card-body px-3 px-md-4">

                        <div class="d-flex justify-content-between
                                    align-items-center py-2">

                            <span class="text-body-secondary">
                                Disponibilidad
                            </span>

                            @if (Model.Disponible)
                            {
                                <span class="badge rounded-pill
                                             bg-success-subtle
                                             text-success-emphasis
                                             border border-success-subtle">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill
                                             bg-secondary-subtle
                                             text-secondary-emphasis
                                             border border-secondary-subtle">

                                    <i class="bi bi-dash-circle me-1"></i>
                                    No disponible
                                </span>
                            }
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between
                                    align-items-center py-2">

                            <span class="text-body-secondary">
                                Registro
                            </span>

                            @if (Model.Activo)
                            {
                                <span class="badge rounded-pill
                                             bg-success-subtle
                                             text-success-emphasis
                                             border border-success-subtle">

                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill
                                             bg-danger-subtle
                                             text-danger-emphasis
                                             border border-danger-subtle">

                                    Inactivo
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Propietario -->
                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-body border-0
                                px-3 px-md-4 pt-4 pb-2">

                        <h2 class="h5 fw-bold mb-0">
                            Propietario
                        </h2>
                    </div>

                    <div class="card-body px-3 px-md-4">

                        @if (Model.Propietario != null)
                        {
                            <div class="d-flex align-items-center gap-3">

                                <div class="rounded-circle
                                            bg-primary bg-opacity-10
                                            text-primary
                                            d-flex align-items-center
                                            justify-content-center"
                                     style="width: 48px; height: 48px;">

                                    <i class="bi bi-person fs-5"></i>
                                </div>

                                <div>
                                    <div class="fw-semibold">
                                        @Model.Propietario.Nombre
                                        @Model.Propietario.Apellido
                                    </div>

                                    <div class="small text-body-secondary">
                                        DNI @Model.Propietario.Dni
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">

                                <div class="small text-body-secondary mb-1">
                                    Email
                                </div>

                                <div class="text-break">
                                    <i class="bi bi-envelope me-2"></i>
                                    @Model.Propietario.Email
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-body-secondary">
                                <i class="bi bi-person-x me-2"></i>
                                No hay propietario asociado.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Ubicación -->
        <div class="card border-0 shadow-sm mt-4">

            <div class="card-header bg-body border-0
                        px-3 px-md-4 pt-4 pb-2">

                <h2 class="h5 fw-bold mb-0">
                    Ubicación
                </h2>
            </div>

            <div class="card-body px-3 px-md-4">

                @if (Model.Latitud.HasValue &&
                     Model.Longitud.HasValue)
                {
                    <div class="rounded-3 bg-body-secondary
                                d-flex flex-column
                                align-items-center justify-content-center
                                text-center p-4"
                         style="min-height: 180px;">

                        <i class="bi bi-map display-5
                                  text-body-secondary mb-2"></i>

                        <div class="fw-semibold">
                            Coordenadas registradas
                        </div>

                        <div class="small text-body-secondary">
                            @Model.Latitud.Value.ToString("0.#######"),
                            @Model.Longitud.Value.ToString("0.#######")
                        </div>
                    </div>
                }
                else
                {
                    <div class="rounded-3 bg-body-secondary
                                text-center p-4">

                        <i class="bi bi-geo-alt display-6
                                  text-body-secondary mb-2"></i>

                        <div class="fw-semibold">
                            Ubicación no registrada
                        </div>

                        <div class="small text-body-secondary">
                            Este inmueble todavía no tiene coordenadas.
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Acciones inferiores -->
        <div class="d-flex flex-column flex-sm-row
                    justify-content-between
                    align-items-sm-center
                    gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Volver al listado
            </a>

            <div class="d-flex gap-2">

                <a asp-action="Editar"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i>
                    Editar inmueble
                </a>

            </div>
        </div>

    </div>
</div>