@model PagedResults<INMOBILIARIA.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";

    string termino = ViewBag.Termino ?? "";
    bool? disponible = ViewBag.Disponible;
    bool? activo = ViewBag.Activo;
    int limit = ViewBag.Limit ?? 10;
}

<div class="container py-4">
    <div class="mx-auto" style="max-width: 1250px;">

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm"
                 role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["Mensaje"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm"
                 role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <!-- Encabezado -->
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center
                    gap-3 mb-4">

            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div class="bg-primary bg-opacity-10
                                text-primary rounded-3
                                d-flex align-items-center justify-content-center"
                         style="width: 42px; height: 42px;">
                        <i class="bi bi-buildings fs-5"></i>
                    </div>

                    <h1 class="h3 fw-bold mb-0">
                        Inmuebles
                    </h1>
                </div>

                <p class="text-body-secondary mb-0">
                    Administración de propiedades disponibles en el sistema.
                </p>
            </div>

            <a asp-action="Crear"
               class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                Nuevo inmueble
            </a>
        </div>

        <!-- Filtros -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">

                <form asp-action="Index"
                      method="get">

                    <div class="row g-3 align-items-end">

                        <!-- Búsqueda -->
                        <div class="col-12 col-lg-5">
                            <label for="termino"
                                   class="form-label fw-semibold">
                                Buscar
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-body">
                                    <i class="bi bi-search"></i>
                                </span>

                                <input type="text"
                                       id="termino"
                                       name="termino"
                                       value="@termino"
                                       class="form-control"
                                       placeholder="Dirección, propietario o tipo..." />
                            </div>
                        </div>

                        <!-- Disponibilidad -->
                        <div class="col-12 col-md-4 col-lg-2">
                            <label for="disponible"
                                   class="form-label fw-semibold">
                                Disponibilidad
                            </label>

                            <select id="disponible"
                                    name="disponible"
                                    class="form-select">

                                <option value=""
                                        selected="@(disponible == null)">
                                    Todas
                                </option>

                                <option value="true"
                                        selected="@(disponible == true)">
                                    Disponible
                                </option>

                                <option value="false"
                                        selected="@(disponible == false)">
                                    No disponible
                                </option>

                            </select>
                        </div>

                        @if(User.IsInRole("ADMINISTRADOR")) { 
                            <!-- Estado -->
                            <div class="col-12 col-md-4 col-lg-2">
                                <label for="activo"
                                    class="form-label fw-semibold">
                                    Estado
                                </label>

                                <select id="activo"
                                        name="activo"
                                        class="form-select">

                                    <option value=""
                                            selected="@(activo == null)">
                                        Todos
                                    </option>

                                    <option value="true"
                                            selected="@(activo == true)">
                                        Activos
                                    </option>

                                    <option value="false"
                                            selected="@(activo == false)">
                                        Inactivos
                                    </option>

                                </select>
                            </div>
                        }

                        <!-- Cantidad -->
                        <div class="col-12 col-md-4 col-lg-1">
                            <label for="limit"
                                   class="form-label fw-semibold">
                                Mostrar
                            </label>

                            <select id="limit"
                                    name="limit"
                                    class="form-select">

                                <option value="10"
                                        selected="@(limit == 10)">
                                    10
                                </option>

                                <option value="25"
                                        selected="@(limit == 25)">
                                    25
                                </option>

                                <option value="50"
                                        selected="@(limit == 50)">
                                    50
                                </option>

                            </select>
                        </div>

                        <!-- Acciones -->
                        <div class="col-12 col-lg-2 d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">
                                <i class="bi bi-funnel me-1"></i>
                                Filtrar
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary"
                               title="Limpiar filtros">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>

                        </div>

                    </div>

                </form>

            </div>
        </div>

        <!-- Listado -->
        <div class="card border-0 shadow-sm overflow-hidden">

            <div class="card-header bg-body border-0
                        px-3 px-md-4 py-3">

                <div class="d-flex justify-content-between
                            align-items-center">

                    <div>
                        <h2 class="h6 fw-bold mb-1">
                            Listado de inmuebles
                        </h2>

                        <span class="text-body-secondary small">
                            @Model.TotalResults
                            @(Model.TotalResults == 1
                                ? "resultado"
                                : "resultados")
                        </span>
                    </div>

                    <span class="badge text-bg-light border">
                        Página @Model.CurrentPage
                    </span>

                </div>

            </div>

            @if (!Model.Resultados.Any())
            {
                <div class="card-body text-center py-5">

                    <div class="text-body-secondary mb-3">
                        <i class="bi bi-buildings display-5"></i>
                    </div>

                    <h3 class="h6 fw-bold">
                        No se encontraron inmuebles
                    </h3>

                    <p class="text-body-secondary mb-0">
                        Probá modificando los filtros o registrá un nuevo inmueble.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 ps-md-4"
                                    style="width: 90px;">
                                    Imagen
                                </th>

                                <th>
                                    Inmueble
                                </th>

                                <th>
                                    Propietario
                                </th>

                                <th>
                                    Precio / día
                                </th>

                                <th class="text-center">
                                    Cupo
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="text-end pe-3 pe-md-4">
                                    Acciones
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var inmueble in Model.Resultados)
                            {
                                <tr>
                                    <!-- Portada -->
                                    <td class="ps-3 ps-md-4">
                                        @{
                                            var imagenesPorInmueble =
                                                ViewBag.Imagenes
                                                as Dictionary<int, IEnumerable<ImagenInmueble>>;

                                            IEnumerable<ImagenInmueble> imagenesInmueble =
                                                imagenesPorInmueble != null &&
                                                imagenesPorInmueble.ContainsKey(inmueble.Id)
                                                    ? imagenesPorInmueble[inmueble.Id]
                                                    : Enumerable.Empty<ImagenInmueble>();

                                            ImagenInmueble? imagenPrincipal =
                                                imagenesInmueble.FirstOrDefault();
                                        }

                                        @if (imagenPrincipal != null)
                                        {
                                            <img src="@imagenPrincipal.Path"
                                                alt="Imagen de @inmueble.Direccion"
                                                class="rounded-3"
                                                style="width: 64px;
                                                        height: 52px;
                                                        object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-3 bg-body-secondary
                                                        d-flex align-items-center
                                                        justify-content-center"
                                                style="width: 64px; height: 52px;">
                                                <i class="bi bi-image
                                                        text-body-secondary fs-4"></i>
                                            </div>
                                        }
                                    </td>

                                    <!-- Inmueble -->
                                    <td>

                                        <div class="fw-semibold">
                                            @(inmueble.TipoInmueble?.Nombre
                                                ?? "Sin tipo")
                                        </div>

                                        <div class="small text-body-secondary">
                                            @inmueble.Direccion
                                        </div>

                                        @if (inmueble.Latitud.HasValue &&
                                             inmueble.Longitud.HasValue)
                                        {
                                            <span class="small text-success">
                                                <i class="bi bi-geo-alt me-1"></i>
                                                Ubicación registrada
                                            </span>
                                        }

                                    </td>

                                    <!-- Propietario -->
                                    <td>

                                        @if (inmueble.Propietario != null)
                                        {
                                            <div class="fw-semibold">
                                                @inmueble.Propietario.Nombre
                                                @inmueble.Propietario.Apellido
                                            </div>

                                            <div class="small text-body-secondary">
                                                DNI @inmueble.Propietario.Dni
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-body-secondary">
                                                Sin propietario
                                            </span>
                                        }

                                    </td>

                                    <!-- Precio -->
                                    <td>

                                        <span class="fw-semibold">
                                            @inmueble.PrecioDia.ToString("C2")
                                        </span>

                                        <div class="small text-body-secondary">
                                            por día
                                        </div>

                                    </td>

                                    <!-- Cupo -->
                                    <td class="text-center">

                                        <span class="badge rounded-pill
                                                     text-bg-light border">
                                            @inmueble.Cupo
                                        </span>

                                    </td>

                                    <!-- Estado -->
                                    <td>

                                        @if (inmueble.Disponible)
                                        {
                                            <span class="badge rounded-pill
                                                         bg-success-subtle
                                                         text-success-emphasis
                                                         border border-success-subtle">
                                                Disponible
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill
                                                         bg-secondary-subtle
                                                         text-secondary-emphasis
                                                         border border-secondary-subtle">
                                                No disponible
                                            </span>
                                        }

                                        @if (!inmueble.Activo)
                                        {
                                            <div class="mt-1">
                                                <span class="badge rounded-pill
                                                             bg-danger-subtle
                                                             text-danger-emphasis
                                                             border border-danger-subtle">
                                                    Inactivo
                                                </span>
                                            </div>
                                        }

                                    </td>

                                    <!-- Acciones -->
                                    <td class="text-end pe-3 pe-md-4">

                                        <div class="d-inline-flex gap-1">

                                            <a asp-action="Detalle"
                                               asp-route-id="@inmueble.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Ver detalle">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="Editar"
                                               asp-route-id="@inmueble.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            @if (inmueble.Activo && User.IsInRole("ADMINISTRADOR"))
                                            {
                                                <form asp-action="Eliminar"
                                                      asp-route-id="@inmueble.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('¿Seguro que querés dar de baja este inmueble?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Dar de baja">
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- Paginación -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-body border-0
                                px-3 px-md-4 py-3">

                        <nav aria-label="Paginación de inmuebles">

                            <ul class="pagination
                                       pagination-sm
                                       justify-content-center
                                       mb-0">

                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-termino="@termino"
                                           asp-route-disponible="@disponible"
                                           asp-route-activo="@activo"
                                           asp-route-limit="@limit"
                                           asp-route-page="@(Model.CurrentPage - 1)">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>

                                    </li>
                                }

                                @for (int pagina = 1;
                                      pagina <= Model.TotalPages;
                                      pagina++)
                                {
                                    <li class="page-item
                                               @(pagina == Model.CurrentPage
                                                   ? "active"
                                                   : "")">

                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-termino="@termino"
                                           asp-route-disponible="@disponible"
                                           asp-route-activo="@activo"
                                           asp-route-limit="@limit"
                                           asp-route-page="@pagina">
                                            @pagina
                                        </a>

                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-termino="@termino"
                                           asp-route-disponible="@disponible"
                                           asp-route-activo="@activo"
                                           asp-route-limit="@limit"
                                           asp-route-page="@(Model.CurrentPage + 1)">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>

                                    </li>
                                }

                            </ul>

                        </nav>

                    </div>
                }
            }

        </div>

    </div>
</div>