@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero / Presentación -->
<section class="py-5">
    <div class="container">
        <div class="mx-auto" style="max-width: 1250px;">

            <div class="row align-items-center g-5 py-lg-4">

                <!-- Presentación -->
                <div class="col-12 col-lg-7">

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge text-bg-primary">
                            Gestión inmobiliaria
                        </span>

                        <span class="small text-body-secondary">
                            Plataforma administrativa
                        </span>
                    </div>

                    <h1 class="display-5 fw-bold lh-sm mb-4">
                        Todo lo que necesitás para
                        <span class="text-primary">
                            gestionar tu inmobiliaria.
                        </span>
                    </h1>

                    <p class="lead text-body-secondary mb-4">
                        Centralizá propiedades, propietarios, inquilinos,
                        reservas y pagos desde un único lugar, con
                        información organizada y accesible para todo el equipo.
                    </p>

                    <div class="d-flex flex-column flex-sm-row gap-2">

                        <a asp-controller="Inmueble"
                           asp-action="Index"
                           class="btn btn-primary btn-lg px-4 d-inline-flex
                                  align-items-center justify-content-center gap-2">

                            <i class="bi bi-building"></i>
                            Gestionar inmuebles
                        </a>

                        <a asp-controller="Pago"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-lg px-4
                                  d-inline-flex align-items-center
                                  justify-content-center gap-2">

                            <i class="bi bi-receipt"></i>
                            Ver pagos
                        </a>

                    </div>
                </div>

                <!-- Panel visual -->
                <div class="col-12 col-lg-5">

                    <div class="card border-0 shadow-sm overflow-hidden">

                        <div class="card-body p-4 p-md-5">

                            <div class="rounded-4
                                        bg-body-secondary
                                        border
                                        p-4 mb-4">

                                <div class="d-flex justify-content-between
                                            align-items-center mb-4">

                                    <div>
                                        <div class="small text-body-secondary">
                                            Panel de gestión
                                        </div>

                                        <div class="fw-bold fs-5">
                                            Resumen operativo
                                        </div>
                                    </div>

                                    <div class="rounded-3
                                                bg-primary
                                                bg-opacity-10
                                                text-primary
                                                d-flex align-items-center
                                                justify-content-center"
                                         style="width: 44px; height: 44px;">

                                        <i class="bi bi-bar-chart fs-5"></i>
                                    </div>
                                </div>

                                <div class="row g-3">

                                    <div class="col-6">
                                        <div class="bg-body rounded-3 border p-3">
                                            <div class="small text-body-secondary">
                                                Inmuebles
                                            </div>

                                            <div class="fs-4 fw-bold mt-1">
                                                <i class="bi bi-building
                                                          text-primary me-1"></i>
                                                Gestión
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6">
                                        <div class="bg-body rounded-3 border p-3">
                                            <div class="small text-body-secondary">
                                                Operaciones
                                            </div>

                                            <div class="fs-4 fw-bold mt-1">
                                                <i class="bi bi-arrow-left-right
                                                          text-primary me-1"></i>
                                                Control
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="bg-body rounded-3 border p-3">

                                            <div class="d-flex
                                                        justify-content-between
                                                        align-items-center">

                                                <div>
                                                    <div class="small text-body-secondary">
                                                        Información centralizada
                                                    </div>

                                                    <div class="fw-semibold mt-1">
                                                        Una visión completa del negocio
                                                    </div>
                                                </div>

                                                <i class="bi bi-check-circle-fill
                                                          text-success fs-4">
                                                </i>
                                            </div>

                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="d-flex justify-content-between
                                        align-items-center">

                                <span class="small text-body-secondary">
                                    Sistema de gestión
                                </span>

                                <span class="badge text-bg-success">
                                    Operativo
                                </span>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>


<!-- Módulos -->
<section class="py-5 bg-body-secondary">
    <div class="container">
        <div class="mx-auto" style="max-width: 1250px;">

            <div class="mb-5">

                <span class="small text-primary fw-semibold">
                    ÁREAS DE GESTIÓN
                </span>

                <h2 class="h2 fw-bold mt-2 mb-2">
                    Una plataforma para trabajar mejor
                </h2>

                <p class="text-body-secondary mb-0"
                   style="max-width: 700px;">
                    Accedé rápidamente a las principales áreas del sistema
                    y mantené toda la información de la inmobiliaria
                    organizada en un solo lugar.
                </p>

            </div>

            <div class="row g-4">

                <!-- Inmuebles -->
                <div class="col-12 col-md-6 col-xl-3">

                    <a asp-controller="Inmueble"
                       asp-action="Index"
                       class="text-decoration-none text-reset">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div class="rounded-3
                                            bg-primary
                                            bg-opacity-10
                                            text-primary
                                            d-flex align-items-center
                                            justify-content-center
                                            mb-4"
                                     style="width: 48px; height: 48px;">

                                    <i class="bi bi-building fs-5"></i>
                                </div>

                                <h3 class="h5 fw-bold mb-2">
                                    Inmuebles
                                </h3>

                                <p class="text-body-secondary mb-3">
                                    Administrá propiedades, disponibilidad,
                                    precios, ubicación e imágenes.
                                </p>

                                <span class="small text-primary fw-semibold">
                                    Gestionar
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </span>

                            </div>
                        </div>

                    </a>
                </div>


                <!-- Propietarios -->
                <div class="col-12 col-md-6 col-xl-3">

                    <a asp-controller="Propietario"
                       asp-action="Index"
                       class="text-decoration-none text-reset">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div class="rounded-3
                                            bg-primary
                                            bg-opacity-10
                                            text-primary
                                            d-flex align-items-center
                                            justify-content-center
                                            mb-4"
                                     style="width: 48px; height: 48px;">

                                    <i class="bi bi-person-vcard fs-5"></i>
                                </div>

                                <h3 class="h5 fw-bold mb-2">
                                    Propietarios
                                </h3>

                                <p class="text-body-secondary mb-3">
                                    Consultá y administrá la información
                                    de los propietarios.
                                </p>

                                <span class="small text-primary fw-semibold">
                                    Gestionar
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </span>

                            </div>
                        </div>

                    </a>
                </div>


                <!-- Inquilinos -->
                <div class="col-12 col-md-6 col-xl-3">

                    <a asp-controller="Inquilino"
                       asp-action="Index"
                       class="text-decoration-none text-reset">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div class="rounded-3
                                            bg-primary
                                            bg-opacity-10
                                            text-primary
                                            d-flex align-items-center
                                            justify-content-center
                                            mb-4"
                                     style="width: 48px; height: 48px;">

                                    <i class="bi bi-people fs-5"></i>
                                </div>

                                <h3 class="h5 fw-bold mb-2">
                                    Inquilinos
                                </h3>

                                <p class="text-body-secondary mb-3">
                                    Gestioná los datos y el estado
                                    de los inquilinos registrados.
                                </p>

                                <span class="small text-primary fw-semibold">
                                    Gestionar
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </span>

                            </div>
                        </div>

                    </a>
                </div>


                <!-- Pagos -->
                <div class="col-12 col-md-6 col-xl-3">

                    <a asp-controller="Pago"
                       asp-action="Index"
                       class="text-decoration-none text-reset">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div class="rounded-3
                                            bg-primary
                                            bg-opacity-10
                                            text-primary
                                            d-flex align-items-center
                                            justify-content-center
                                            mb-4"
                                     style="width: 48px; height: 48px;">

                                    <i class="bi bi-receipt fs-5"></i>
                                </div>

                                <h3 class="h5 fw-bold mb-2">
                                    Pagos
                                </h3>

                                <p class="text-body-secondary mb-3">
                                    Consultá, registrá y controlá
                                    las operaciones de pago.
                                </p>

                                <span class="small text-primary fw-semibold">
                                    Gestionar
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </span>

                            </div>
                        </div>

                    </a>
                </div>

            </div>
        </div>
    </div>
</section>


<!-- Información operativa -->
<section class="py-5">
    <div class="container">
        <div class="mx-auto" style="max-width: 1250px;">

            <div class="row g-4 align-items-stretch">

                <!-- Mensaje -->
                <div class="col-12 col-lg-7">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4 p-md-5">

                            <div class="d-flex align-items-start gap-3">

                                <div class="rounded-3
                                            bg-primary
                                            bg-opacity-10
                                            text-primary
                                            d-flex align-items-center
                                            justify-content-center
                                            flex-shrink-0"
                                     style="width: 48px; height: 48px;">

                                    <i class="bi bi-layers fs-5"></i>
                                </div>

                                <div>

                                    <h2 class="h4 fw-bold mb-2">
                                        Información centralizada
                                    </h2>

                                    <p class="text-body-secondary mb-0">
                                        El sistema permite mantener organizada
                                        la información de las propiedades y
                                        las operaciones relacionadas,
                                        facilitando el trabajo diario
                                        del equipo.
                                    </p>

                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="row g-3">

                                <div class="col-12 col-sm-4">
                                    <div class="d-flex gap-2">
                                        <i class="bi bi-check-circle
                                                  text-success mt-1">
                                        </i>

                                        <div>
                                            <div class="fw-semibold">
                                                Información organizada
                                            </div>

                                            <div class="small text-body-secondary">
                                                Datos centralizados.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-sm-4">
                                    <div class="d-flex gap-2">
                                        <i class="bi bi-check-circle
                                                  text-success mt-1">
                                        </i>

                                        <div>
                                            <div class="fw-semibold">
                                                Gestión ágil
                                            </div>

                                            <div class="small text-body-secondary">
                                                Acceso rápido a cada módulo.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-sm-4">
                                    <div class="d-flex gap-2">
                                        <i class="bi bi-check-circle
                                                  text-success mt-1">
                                        </i>

                                        <div>
                                            <div class="fw-semibold">
                                                Trabajo en equipo
                                            </div>

                                            <div class="small text-body-secondary">
                                                Información compartida.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>


                <!-- Acceso rápido -->
                <div class="col-12 col-lg-5">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4 p-md-5">

                            <div class="small text-primary fw-semibold mb-2">
                                ACCESO RÁPIDO
                            </div>

                            <h2 class="h4 fw-bold mb-2">
                                Continuá trabajando
                            </h2>

                            <p class="text-body-secondary mb-4">
                                Accedé directamente a las operaciones
                                que forman parte de la gestión diaria.
                            </p>

                            <div class="d-grid gap-2">

                                <a asp-controller="Inmueble"
                                   asp-action="Crear"
                                   class="btn btn-primary
                                          d-flex align-items-center
                                          justify-content-between">

                                    <span>
                                        <i class="bi bi-plus-circle me-2"></i>
                                        Nuevo inmueble
                                    </span>

                                    <i class="bi bi-arrow-right"></i>
                                </a>

                                <a asp-controller="Inmueble"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary
                                          d-flex align-items-center
                                          justify-content-between">

                                    <span>
                                        <i class="bi bi-building me-2"></i>
                                        Consultar inmuebles
                                    </span>

                                    <i class="bi bi-arrow-right"></i>
                                </a>

                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>