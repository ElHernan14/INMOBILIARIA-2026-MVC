@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero -->
<section class="py-5">

    <div class="container">

        <div class="row align-items-center g-5 py-lg-5">

            <div class="col-12 col-lg-7">

                <span class="badge text-bg-primary mb-3">
                    Tu próximo lugar empieza acá
                </span>

                <h1 class="display-4 fw-bold lh-sm mb-4">
                    Encontrá el lugar
                    <span class="text-primary">donde querés estar.</span>
                </h1>

                <p class="lead text-secondary mb-4">
                    Te acompañamos en cada paso para encontrar,
                    alquilar y gestionar tu próxima propiedad
                    de manera simple y transparente.
                </p>

                <div class="d-flex flex-column flex-sm-row gap-2">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Inmueble"
                           asp-action="Index"
                           class="btn btn-primary btn-lg px-4">
                            Ver propiedades
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Usuario"
                           asp-action="Login"
                           class="btn btn-primary btn-lg px-4">
                            Iniciar sesión
                        </a>

                        <a asp-controller="Usuario"
                           asp-action="Register"
                           class="btn btn-outline-secondary btn-lg px-4">
                            Crear cuenta
                        </a>
                    }

                </div>

            </div>


            <div class="col-12 col-lg-5">

                <div class="card border-0 shadow-sm overflow-hidden">

                    <div class="card-body p-4 p-md-5">

                        <div class="d-flex align-items-center
                                    justify-content-center
                                    rounded-4
                                    bg-light
                                    border
                                    mb-4"
                             style="height: 280px;">

                            <div class="text-center px-4">

                                <div class="display-3 mb-3">
                                    🏠
                                </div>

                                <h2 class="h4 fw-bold mb-2">
                                    Tu próximo hogar
                                </h2>

                                <p class="text-secondary mb-0">
                                    Espacios para vivir,
                                    crecer y disfrutar.
                                </p>

                            </div>

                        </div>

                        <div class="d-flex justify-content-between
                                    align-items-center">

                            <span class="small text-secondary">
                                Gestión inmobiliaria
                            </span>

                            <span class="badge text-bg-success">
                                Simple y transparente
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Características -->
<section class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">

            <span class="small text-primary fw-semibold">
                NUESTRA PROPUESTA
            </span>

            <h2 class="h2 fw-bold mt-2 mb-2">
                Todo más simple
            </h2>

            <p class="text-secondary mb-0">
                Una experiencia pensada para que encontrar
                y gestionar una propiedad sea más fácil.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-12 col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="fs-2 mb-3">
                            🏡
                        </div>

                        <h3 class="h5 fw-bold">
                            Propiedades
                        </h3>

                        <p class="text-secondary mb-0">
                            Conocé las propiedades disponibles
                            y encontrá el espacio que mejor se
                            adapte a tus necesidades.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-12 col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="fs-2 mb-3">
                            🤝
                        </div>

                        <h3 class="h5 fw-bold">
                            Atención personalizada
                        </h3>

                        <p class="text-secondary mb-0">
                            Te acompañamos durante el proceso
                            para que puedas tomar decisiones
                            con tranquilidad.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-12 col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="fs-2 mb-3">
                            ✨
                        </div>

                        <h3 class="h5 fw-bold">
                            Gestión simple
                        </h3>

                        <p class="text-secondary mb-0">
                            Centralizamos la información para
                            facilitar la administración de
                            propiedades y operaciones.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- CTA -->
<section class="py-5">

    <div class="container">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-md-5">

                <div class="row align-items-center g-4">

                    <div class="col-12 col-md-8">

                        <h2 class="h3 fw-bold mb-2">
                            ¿Buscás una nueva propiedad?
                        </h2>

                        <p class="text-secondary mb-0">
                            Ingresá a tu cuenta para comenzar
                            a gestionar tu experiencia inmobiliaria.
                        </p>

                    </div>

                    <div class="col-12 col-md-4 text-md-end">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Usuario"
                               asp-action="Perfil"
                               class="btn btn-primary">
                                Ir a mi perfil
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Usuario"
                               asp-action="Register"
                               class="btn btn-primary">
                                Crear mi cuenta
                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>