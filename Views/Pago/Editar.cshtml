@model INMOBILIARIA.Models.Pago

@{
    ViewData["Title"] = "Editar pago";

    var reservas =
        ViewBag.Reservas as IEnumerable<INMOBILIARIA.Models.Reserva>
        ?? Enumerable.Empty<INMOBILIARIA.Models.Reserva>();
}

<div class="container py-4">

    <div class="mb-4">

        <h1 class="h3 mb-1">
            Editar pago #@Model.Id
        </h1>

        <p class="text-muted mb-0">
            Modificá la información del pago.
        </p>

    </div>

    <form asp-action="Editar"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-12">

                        <label class="form-label">
                            Reserva
                        </label>

                        <select asp-for="Reserva.Id"
                                class="form-select">

                            @foreach (var reserva in reservas)
                            {
                                <option value="@reserva.Id">

                                    Reserva #@reserva.Id -
                                    @reserva.Inmueble?.Direccion -
                                    @reserva.FechaDesde.ToString("dd/MM/yyyy")
                                    a
                                    @reserva.FechaHasta.ToString("dd/MM/yyyy")
                                    -
                                    @reserva.Inquilino?.Nombre
                                    @reserva.Inquilino?.Apellido

                                </option>
                            }

                        </select>

                        <span asp-validation-for="Reserva"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Concepto"
                               class="form-label">
                            Concepto
                        </label>

                        <input asp-for="Concepto"
                               class="form-control" />

                        <span asp-validation-for="Concepto"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="Fecha"
                               class="form-label">
                            Fecha
                        </label>

                        <input asp-for="Fecha"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Fecha"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="Importe"
                               class="form-label">
                            Importe
                        </label>

                        <input asp-for="Importe"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />

                        <span asp-validation-for="Importe"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Guardar cambios
            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}