@model INMOBILIARIA.Models.Usuario

@{
    ViewData["Title"] = "Detalle del usuario";
}

<div class="container py-4">

    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-controller="Usuario"
               asp-action="Index"
               class="text-decoration-none text-secondary">
                Usuarios
            </a>

            <span class="text-secondary">/</span>

            <span class="text-secondary">
                Detalle
            </span>
        </div>

        <h1 class="h3 fw-bold mb-1">
            Detalle del usuario
        </h1>

        <p class="text-secondary mb-0">
            Consultá la información y el estado de este usuario.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="d-flex flex-column flex-sm-row
                                align-items-sm-center
                                gap-4
                                mb-4">

                        <div>
                            @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                            {
                                <img src="@Model.Avatar"
                                     alt="Avatar de @Model.NombreCompleto"
                                     class="rounded-circle border"
                                     width="100"
                                     height="100"
                                     style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light border
                                            d-flex align-items-center
                                            justify-content-center
                                            fw-semibold"
                                     style="width:100px;height:100px;font-size:1.5rem;">

                                    @Model.Nombre.FirstOrDefault()
                                    @Model.Apellido.FirstOrDefault()

                                </div>
                            }
                        </div>

                        <div>
                            <h2 class="h4 fw-bold mb-1">
                                @Model.NombreCompleto
                            </h2>

                            <p class="text-secondary mb-2">
                                @Model.Email
                            </p>

                            <span class="badge @(Model.Rol == INMOBILIARIA.Models.RolUsuario.ADMINISTRADOR
                                                   ? "text-bg-primary"
                                                   : "text-bg-secondary")">
                                @Model.RolNombre
                            </span>

                            <span class="badge @(Model.Activo
                                                   ? "text-bg-success"
                                                   : "text-bg-danger")">
                                @(Model.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="mb-4">

                        <h2 class="h5 fw-semibold mb-1">
                            Datos personales
                        </h2>

                        <p class="small text-secondary mb-3">
                            Información básica del usuario.
                        </p>

                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <div class="small text-secondary mb-1">
                                    Nombre
                                </div>

                                <div class="fw-medium">
                                    @Model.Nombre
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-secondary mb-1">
                                    Apellido
                                </div>

                                <div class="fw-medium">
                                    @Model.Apellido
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-secondary mb-1">
                                    DNI
                                </div>

                                <div class="fw-medium">
                                    @Model.Dni
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-secondary mb-1">
                                    Email
                                </div>

                                <div class="fw-medium">
                                    @Model.Email
                                </div>
                            </div>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <div>

                        <h2 class="h5 fw-semibold mb-1">
                            Acceso y permisos
                        </h2>

                        <p class="small text-secondary mb-3">
                            Información relacionada con el acceso al sistema.
                        </p>

                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <div class="small text-secondary mb-1">
                                    Rol
                                </div>

                                <div class="fw-medium">
                                    @Model.RolNombre
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-secondary mb-1">
                                    Estado
                                </div>

                                <div class="fw-medium">
                                    @(Model.Activo ? "Usuario activo" : "Usuario inactivo")
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-between
                                gap-2
                                border-top
                                mt-4
                                pt-4">

                        <a asp-controller="Usuario"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Volver
                        </a>

                        <div class="d-flex gap-2">

                            <a asp-controller="Usuario"
                               asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-primary">
                                Editar usuario
                            </a>

                            <a asp-controller="Usuario"
                               asp-action="Delete"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-danger">
                                Eliminar
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>