@model INMOBILIARIA.Models.Usuario

@{
    ViewData["Title"] = "Eliminar usuario";
}

<div class="container py-4">

    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-controller="Usuario"
               asp-action="Index"
               class="text-decoration-none text-secondary">
                Usuarios
            </a>

            <span class="text-secondary">/</span>

            <span class="text-secondary">
                Eliminar
            </span>
        </div>

        <h1 class="h3 fw-bold mb-1">
            Eliminar usuario
        </h1>

        <p class="text-secondary mb-0">
            Confirmá la baja del usuario seleccionado.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                        {
                            <img src="@Model.Avatar"
                                 alt="Avatar de @Model.NombreCompleto"
                                 class="rounded-circle border mb-3"
                                 width="100"
                                 height="100"
                                 style="object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-light border
                                        d-flex align-items-center
                                        justify-content-center
                                        fw-semibold
                                        mx-auto
                                        mb-3"
                                 style="width:100px;height:100px;font-size:1.5rem;">

                                @Model.Nombre.FirstOrDefault()
                                @Model.Apellido.FirstOrDefault()

                            </div>
                        }

                        <h2 class="h4 fw-bold mb-1">
                            @Model.NombreCompleto
                        </h2>

                        <p class="text-secondary mb-0">
                            @Model.Email
                        </p>

                    </div>

                    <div class="alert alert-warning"
                         role="alert">

                        <h3 class="h6 fw-semibold">
                            ¿Estás seguro de eliminar este usuario?
                        </h3>

                        <p class="small mb-0">
                            El usuario dejará de estar activo en el sistema.
                            Esta acción realiza una baja lógica.
                        </p>

                    </div>

                    <div class="bg-light rounded p-3 mb-4">

                        <div class="row g-3">

                            <div class="col-12 col-sm-6">
                                <div class="small text-secondary mb-1">
                                    DNI
                                </div>

                                <div class="fw-medium">
                                    @Model.Dni
                                </div>
                            </div>

                            <div class="col-12 col-sm-6">
                                <div class="small text-secondary mb-1">
                                    Rol
                                </div>

                                <div class="fw-medium">
                                    @Model.RolNombre
                                </div>
                            </div>

                        </div>

                    </div>

                    <form asp-controller="Usuario"
                          asp-action="DeleteConfirmed"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex flex-column flex-sm-row
                                    justify-content-between
                                    gap-2">

                            <a asp-controller="Usuario"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Confirmar eliminación
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>