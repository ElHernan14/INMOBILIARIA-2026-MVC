@model INMOBILIARIA.Models.Usuario

@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container py-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-2">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-decoration-none text-secondary">
                    Inicio
                </a>

                <span class="text-secondary">/</span>

                <span class="text-secondary">
                    Mi perfil
                </span>

            </div>

            <h1 class="h3 fw-bold mb-1">
                Mi perfil
            </h1>

            <p class="text-secondary mb-0">
                Consultá y actualizá la información de tu cuenta.
            </p>
        </div>


        <!-- Volver -->
        <div class="flex-shrink-0">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">

                Volver al inicio

            </a>

        </div>

    </div>


    <form asp-controller="Usuario"
          asp-action="EditarPerfil"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert"></div>


        <div class="row g-4">

            <!-- Tarjeta principal -->
            <div class="col-12 col-lg-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4 text-center">

                        <!-- Avatar -->
                        <div class="mb-3">

                            @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                            {
                                <img id="avatarPreview"
                                     src="@Model.Avatar"
                                     alt="Avatar de @Model.NombreCompleto"
                                     class="rounded-circle border shadow-sm mx-auto"
                                     width="130"
                                     height="130"
                                     style="object-fit: cover;" />
                            }
                            else
                            {
                                <div id="avatarIniciales"
                                     class="rounded-circle bg-light border
                                            d-flex align-items-center
                                            justify-content-center
                                            fw-bold
                                            mx-auto"
                                     style="width:130px;height:130px;font-size:2rem;">

                                    @Model.Nombre.FirstOrDefault()
                                    @Model.Apellido.FirstOrDefault()

                                </div>

                                <img id="avatarPreview"
                                     src=""
                                     alt="Vista previa del avatar"
                                     class="rounded-circle border shadow-sm mx-auto d-none"
                                     width="130"
                                     height="130"
                                     style="object-fit: cover;" />
                            }

                        </div>


                        <!-- Selector de avatar -->
                        <div id="avatarContainer"
                             class="mb-3 d-none text-start">

                            <label for="avatarFile"
                                   class="form-label fw-semibold">

                                Cambiar avatar

                            </label>

                            <input type="file"
                                   id="avatarFile"
                                   name="avatarFile"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" />

                            <div class="form-text">
                                JPG, JPEG, PNG o WEBP. Máximo 2 MB.
                            </div>

                        </div>


                        <h2 class="h4 fw-bold mb-1">
                            @Model.NombreCompleto
                        </h2>

                        <p class="text-secondary mb-3 text-break">
                            @Model.Email
                        </p>


                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                            <span class="badge @(Model.Rol == INMOBILIARIA.Models.RolUsuario.ADMINISTRADOR
                                                     ? "text-bg-primary"
                                                     : "text-bg-secondary")">

                                @Model.RolNombre

                            </span>

                            <span class="badge @(Model.Activo
                                                     ? "text-bg-success"
                                                     : "text-bg-danger")">

                                @(Model.Activo ? "Activo" : "Inactivo")

                            </span>

                        </div>


                        <hr class="my-4" />


                        <!-- Botón editar -->
                        <button type="button"
                                id="btnEditar"
                                class="btn btn-primary w-100">

                            Editar mi información

                        </button>


                        <!-- Acciones de edición -->
                        <div id="accionesEdicion"
                             class="d-none">

                            <div class="d-flex flex-column gap-2">

                                <button type="submit"
                                        class="btn btn-success w-100">

                                    Guardar cambios

                                </button>

                                <button type="button"
                                        id="btnCancelar"
                                        class="btn btn-outline-secondary w-100">

                                    Cancelar

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Información -->
            <div class="col-12 col-lg-8">

                <!-- Datos personales -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-body p-4">

                        <div class="mb-4">

                            <h2 class="h5 fw-semibold mb-1">
                                Datos personales
                            </h2>

                            <p class="small text-secondary mb-0">
                                Información asociada a tu cuenta.
                            </p>

                        </div>


                        <div class="row g-4">

                            <!-- Nombre -->
                            <div class="col-12 col-md-6">

                                <label asp-for="Nombre"
                                       class="form-label fw-semibold">
                                    Nombre
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control perfil-editable"
                                       readonly />

                                <span asp-validation-for="Nombre"
                                      class="text-danger small"></span>

                            </div>


                            <!-- Apellido -->
                            <div class="col-12 col-md-6">

                                <label asp-for="Apellido"
                                       class="form-label fw-semibold">
                                    Apellido
                                </label>

                                <input asp-for="Apellido"
                                       class="form-control perfil-editable"
                                       readonly />

                                <span asp-validation-for="Apellido"
                                      class="text-danger small"></span>

                            </div>


                            <!-- DNI -->
                            <div class="col-12 col-md-6">

                                <label asp-for="Dni"
                                       class="form-label fw-semibold">
                                    DNI
                                </label>

                                <input asp-for="Dni"
                                       class="form-control perfil-editable"
                                       readonly />

                                <span asp-validation-for="Dni"
                                      class="text-danger small"></span>

                            </div>


                            <!-- Email -->
                            <div class="col-12 col-md-6">

                                <label asp-for="Email"
                                       class="form-label fw-semibold">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control perfil-editable"
                                       readonly />

                                <span asp-validation-for="Email"
                                      class="text-danger small"></span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Contraseña -->
                <div id="passwordSection"
                     class="card border-0 shadow-sm mb-4 d-none">

                    <div class="card-body p-4">

                        <div class="mb-4">

                            <h2 class="h5 fw-semibold mb-1">
                                Contraseña
                            </h2>

                            <p class="small text-secondary mb-0">
                                Dejá este campo vacío si querés conservar tu contraseña actual.
                            </p>

                        </div>


                        <label for="Password"
                               class="form-label fw-semibold">

                            Nueva contraseña

                        </label>

                        <input name="Password"
                               id="Password"
                               type="password"
                               class="form-control"
                               placeholder="Ingresá una nueva contraseña"
                               autocomplete="new-password"
                               readonly />

                        <div class="form-text">
                            Si ingresás una nueva contraseña, reemplazará la actual.
                        </div>

                    </div>

                </div>


                <!-- Acceso -->
                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="mb-4">

                            <h2 class="h5 fw-semibold mb-1">
                                Acceso al sistema
                            </h2>

                            <p class="small text-secondary mb-0">
                                Información sobre tu cuenta y permisos.
                            </p>

                        </div>


                        <div class="row g-4">

                            <div class="col-12 col-md-6">

                                <div class="small text-secondary mb-1">
                                    Rol
                                </div>

                                <div class="fw-semibold">
                                    @Model.RolNombre
                                </div>

                            </div>


                            <div class="col-12 col-md-6">

                                <div class="small text-secondary mb-1">
                                    Estado de la cuenta
                                </div>

                                <div class="fw-semibold">
                                    @(Model.Activo
                                        ? "Cuenta activa"
                                        : "Cuenta inactiva")
                                </div>

                            </div>

                        </div>


                        @if (User.IsInRole("ADMINISTRADOR"))
                        {
                            <hr class="my-4" />

                            <div class="d-flex flex-column flex-sm-row
                                        justify-content-between
                                        align-items-sm-center
                                        gap-3">

                                <div>

                                    <div class="fw-semibold">
                                        Administración
                                    </div>

                                    <div class="small text-secondary">
                                        Gestioná los usuarios del sistema.
                                    </div>

                                </div>

                                <a asp-controller="Usuario"
                                   asp-action="Index"
                                   class="btn btn-outline-primary">

                                    Ver usuarios

                                </a>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const btnEditar =
                document.getElementById("btnEditar");

            const btnCancelar =
                document.getElementById("btnCancelar");

            const accionesEdicion =
                document.getElementById("accionesEdicion");

            const passwordSection =
                document.getElementById("passwordSection");

            const passwordInput =
                document.getElementById("Password");

            const avatarContainer =
                document.getElementById("avatarContainer");

            const avatarFile =
                document.getElementById("avatarFile");

            const avatarPreview =
                document.getElementById("avatarPreview");

            const avatarIniciales =
                document.getElementById("avatarIniciales");

            const camposEditables =
                document.querySelectorAll(".perfil-editable");


            function activarEdicion() {

                camposEditables.forEach(function (campo) {

                    campo.removeAttribute("readonly");
                    campo.style.pointerEvents = "auto";

                });


                passwordSection.classList.remove("d-none");

                passwordInput.removeAttribute("readonly");


                avatarContainer.classList.remove("d-none");


                btnEditar.classList.add("d-none");

                accionesEdicion.classList.remove("d-none");


                // El foco inicial indica que el formulario
                // ya está en modo edición.
                const nombre =
                    document.getElementById("Nombre");

                if (nombre) {
                    nombre.focus();
                    nombre.select();
                }

            }


            function cancelarEdicion() {

                window.location.reload();

            }


            btnEditar.addEventListener("click", function () {

                activarEdicion();

            });


            btnCancelar.addEventListener("click", function () {

                cancelarEdicion();

            });


            avatarFile.addEventListener("change", function () {

                const archivo = avatarFile.files[0];

                if (!archivo) {
                    return;
                }

                const url =
                    URL.createObjectURL(archivo);

                avatarPreview.src = url;

                avatarPreview.classList.remove("d-none");

                if (avatarIniciales) {
                    avatarIniciales.classList.add("d-none");
                }

            });

        });

    </script>

    <style>

        /*
         * En modo consulta los inputs conservan
         * apariencia normal, pero no reciben clic.
         *
         * readonly evita que se modifique el contenido.
         * pointer-events evita la interacción con el mouse.
         */
        .perfil-editable[readonly] {
            pointer-events: none;
            cursor: default;
            background-color: var(--bs-body-bg);
        }

    </style>
}