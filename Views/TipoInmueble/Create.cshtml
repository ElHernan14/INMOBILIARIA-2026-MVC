
@model TipoInmueble

@{
	ViewData["Title"] = "Nuevo Tipo de Inmueble";
}

<div class="row justify-content-center">
	<div class="col-12 col-md-8 col-lg-6">
		<h1 class="h2 mb-4">Registrar Tipo de Inmueble</h1>

		@if (TempData["SuccessMessage"] is string successMessage)
		{
			<div class="alert alert-success" role="alert">@successMessage</div>
		}

		<form id="newTipoInmuebleForm"
			  asp-action="Create"
			  asp-controller="TipoInmueble"
			  method="post">
			@Html.AntiForgeryToken()

			<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

			<div class="row g-3">
				<div class="col-md-6">
					<label asp-for="Nombre" class="form-label"></label>
					<input asp-for="Nombre" class="form-control" autocomplete="given-name" />
					<span asp-validation-for="Nombre" class="text-danger"></span>
				</div>

				<div class="col-md-6">
					<label asp-for="Descripcion" class="form-label">Descripción</label>
					<input asp-for="Descripcion" class="form-control" autocomplete="family-name" />
					<span asp-validation-for="Descripcion" class="text-danger"></span>
				</div>
				
				<div class="col-12 d-flex justify-content-end gap-2 mt-4">
					<a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
					<button type="submit" class="btn btn-primary">Registrar Tipo de Inmueble</button>
				</div>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}