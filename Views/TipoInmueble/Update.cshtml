@model TipoInmueble

@{
    ViewData["Title"] = "Editar Tipo de Inmueble";
}

<div class="container py-4">
    <div class="mx-auto" style="max-width: 850px;">

        <!-- Encabezado -->
        <div class="d-flex flex-column flex-sm-row
                    justify-content-between
                    align-items-sm-center
                    gap-3 mb-4">

            <div>
                <h1 class="h2 fw-bold mb-1">
                    Editar tipo de inmueble
                </h1>

                <p class="text-muted mb-0">
                    Actualizá la información del tipo de inmueble.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </a>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">
                @successMessage
            </div>
        }

        <!-- Formulario -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">

                <form id="newTipoInmuebleForm"
                      asp-action="Update"
                      asp-controller="TipoInmueble"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-4">
                    </div>

                    <div class="row g-4">

                        <div class="col-12 col-md-6">
                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   autocomplete="off" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Descripcion"
                                   class="form-label fw-semibold">
                                Descripción
                            </label>

                            <input asp-for="Descripcion"
                                   class="form-control"
                                   autocomplete="off" />

                            <span asp-validation-for="Descripcion"
                                  class="text-danger small">
                            </span>
                        </div>

                    </div>

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-end
                                gap-2 mt-4 pt-3
                                border-top">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>
                            Guardar cambios
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}