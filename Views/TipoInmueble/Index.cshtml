@model INMOBILIARIA.Models.PagedResults<INMOBILIARIA.Models.TipoInmueble>
@{
    ViewData["Title"] = "TipoInmueble";
}

<div id="tipoInmueble-app" class="px-5">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">TipoInmueble</h1>
            <p class="text-muted mb-0">Listado de tipos de inmuebles registrados en la inmobiliaria.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="TipoInmueble" asp-action="Create" class="btn btn-primary">Añadir tipo inmueble</a>
        </div>
    </div>

    <div id="successAlert" class="alert alert-success" role="alert" hidden=true></div>
    <div id="errorAlert" class="alert alert-danger" role="alert" hidden=true></div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    <!-- Listado -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <!-- Cabecera de tabla -->
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 rounded-3 p-2 me-3">
                    <span class="text-primary fw-bold">T</span>
                </div>
                <div>
                    <h2 class="h6 fw-bold mb-0">Tipos de inmueble registrados</h2>
                    <small class="text-muted">Información general</small>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-start ps-4">Nombre</th>
                        <th>Descripción</th>
                        <th class="text-start">Estado</th>
                        <th class="text-start pe-4">Acción</th>
                    </tr>
                </thead>

                <tbody>
                    <!-- Estado vacío -->
                    <tr v-if="resultados.length === 0">
                        <td colspan="3" class="text-center py-5">
                            <div class="mb-2">
                                <span class="fs-3 text-muted">—</span>
                            </div>
                            <div class="fw-semibold">No hay tipos de inmueble registrados</div>
                            <small class="text-muted">Cuando se registren tipos de inmueble aparecerán aquí.</small>
                        </td>
                    </tr>

                    <!-- Tipos de inmueble -->
                    <tr v-for="tipoInmueble in resultados"
                        :key="tipoInmueble.Id">

                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3"
                                     style="width: 42px; height: 42px;">
                                    <span class="fw-bold">{{ iniciales(tipoInmueble) }}</span>
                                </div>
                                <div>
                                    <div class="fw-semibold">{{ tipoInmueble.Nombre }}</div>
                                    <small class="text-muted">Tipo #COD-00{{ tipoInmueble.Id }}</small>
                                </div>
                            </div>
                        </td>

                        <td>{{ tipoInmueble.Descripcion }}</td>

                        <td>
                            <span v-if="tipoInmueble.Activo"
                                  class="badge rounded-pill text-bg-success">
                                Activo
                            </span>
                            <span v-else
                                  class="badge rounded-pill text-bg-secondary">
                                Inactivo
                            </span>
                        </td>

                        <td>
                            <a :href="editUrl(tipoInmueble.Id)"
                               class="btn btn-sm btn-outline-primary px-3">
                                Editar
                                <span class="ms-1">
                                    <i class="bi bi-pencil-square"></i>
                                </span>
                            </a>
                            
                            <a href="#"
                               @@click.prevent="deleteTI(tipoInmueble.Id)"
                               class="btn btn-sm btn-outline-danger px-3">
                                Eliminar
                                <span class="ms-1">
                                    <i class="bi bi-trash-fill"></i>
                                </span>
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Paginado -->
    <div>
        <nav aria-label="Page navigation" class="py-3">
            <ul class="pagination justify-content-center">
                <li class="page-item" :class="{ disabled: currentPage === 1 }"><a class="page-link" :href="getPage(currentPage - 1)">Previous</a></li>
                <li class="page-item" 
                    v-for="(page, index) in visiblePages"
                    :key="index"
                    :class="{ active: currentPage === page, disabled: page === '...' }">
                    <a class="page-link" v-if="page !== '...'" :href="getPage(page)">{{ page }}</a>
                    <span class="page-link" v-else>...</span>
                <li class="page-item" :class="{ disabled: currentPage === totalPages }"><a class="page-link" :href="getPage(currentPage + 1)">Next</a></li>
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({

            data() {
                return {
                    /*
                     * Los datos son enviados por Razor desde el Controller.
                     * Vue no consulta ni genera datos.
                     */
                    resultados: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(Model?.Resultados ?? new List<INMOBILIARIA.Models.TipoInmueble>())
                    ),
                    currentPage: @Model?.CurrentPage ?? 1,
                    pageSize: @Model?.PageSize ?? 10,
                    totalResults: @Model?.TotalResults ?? 0,
                    totalPages: @Model?.TotalPages ?? 0
                };
            },

            computed: {
                visiblePages() {
                    const total = this.totalPages;
                    const current = this.currentPage;
                    
                    // Number of buttons to show on each side of the current page
                    const delta = 2; 

                    // If the total pages are 7 or less show all of them
                    if (total <= 7) {
                        return Array.from({ length: total }, (_, i) => i + 1);
                    }

                    const pages = [];
                    
                    // Calculate the window of pages around the current page
                    const left = Math.max(2, current - delta);
                    const right = Math.min(total - 1, current + delta);

                    // Always show the first page
                    pages.push(1);

                    // Add an ellipsis if there is a gap between 1 and the left window
                    if (left > 2) {
                        pages.push('...');
                    }

                    // Add the numbers in the window
                    for (let i = left; i <= right; i++) {
                        pages.push(i);
                    }

                    // Add an ellipsis if there is a gap between the right window and the last page
                    if (right < total - 1) {
                        pages.push('...');
                    }

                    // Always show the last page
                    pages.push(total);

                    return pages;
                }
            },

            methods: {

                iniciales(tipoInmueble) {
                    const nombre =
                        tipoInmueble.Nombre?.charAt(0) ?? "";

                    return nombre.toUpperCase();
                },


                getPage(index) {
                    return `/TipoInmueble?page=${index}`;
                },

                editUrl(id) {
                    return `/TipoInmueble/Update/${id}`;
                },

                async deleteTI(id) {
                    let success = document.getElementById("successAlert");
                    let error = document.getElementById("errorAlert");
                    const response = await fetch(`/TipoInmueble/Delete/${id}`, { 
                        method: "DELETE",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });
                    if (response.ok) {
                        error.hidden = true;
                        this.resultados = this.resultados.filter(p => p.Id !== id);
                        success.textContent = `Tipo de Inmueble codigo COD-00${id} eliminado.`;
                        success.hidden = false;
                    } else {
                        success.hidden = true;
                        error.textContent = `No se pudo eliminar el Tipo de Inmueble con el codigo COD-00${id}.`;
                        error.hidden = false;
                    }
                }
            }

        }).mount("#tipoInmueble-app");
    </script>
}